<Window x:Class="AutoAddSchedule.UI.Capture.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图选区"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Cursor="Cross"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="CaptureAccentBrush" Color="#2F6FED" />
        <SolidColorBrush x:Key="CaptureToolbarBackgroundBrush" Color="#E61F2733" />
        <SolidColorBrush x:Key="CaptureToolbarBorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="CaptureToolbarHoverBrush" Color="#33FFFFFF" />

        <Style x:Key="CaptureToolbarButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#E8ECF2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{StaticResource CaptureToolbarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptureToolbarPrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CaptureToolbarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource CaptureAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- 本显示器的屏幕截图，按窗口物理矩形 1:1 显示 -->
        <Image x:Name="ScreenImage"
               Stretch="Fill"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!-- 暗色遮罩与选区绘制层，同时承接鼠标拖选 -->
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                MouseMove="OverlayCanvas_MouseMove"
                MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
            <Path x:Name="DimPath" Fill="#99000000" IsHitTestVisible="False" />
            <Path x:Name="SelectionBorderPath"
                  Stroke="#FF2F6FED"
                  StrokeThickness="2"
                  StrokeLineJoin="Miter"
                  IsHitTestVisible="False"
                  Visibility="Collapsed" />
            <Border x:Name="SizeTip"
                    Background="#E6000000"
                    CornerRadius="4"
                    Padding="8,4"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeTipText"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="12"
                           Foreground="White" />
            </Border>
            <Border x:Name="HintPanel"
                    Background="#CC1F2733"
                    CornerRadius="6"
                    Padding="16,10"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="拖动鼠标框选要识别的区域"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="14"
                               Foreground="#F2FFFFFF"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="按 Esc 取消"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12"
                               Foreground="#B3FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 工具条独立一层，避免点击按钮时触发重新框选 -->
        <Canvas x:Name="ToolbarLayer">
            <Border x:Name="ToolBar"
                    Background="{StaticResource CaptureToolbarBackgroundBrush}"
                    BorderBrush="{StaticResource CaptureToolbarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConfirmButton"
                            Content="确定"
                            Style="{StaticResource CaptureToolbarPrimaryButtonStyle}"
                            Click="ConfirmButton_Click" />
                    <Button x:Name="CancelButton"
                            Content="放弃"
                            Style="{StaticResource CaptureToolbarButtonStyle}"
                            Margin="4,0,0,0"
                            Click="CancelButton_Click" />
                    <Button x:Name="ResetButton"
                            Content="重选"
                            Style="{StaticResource CaptureToolbarButtonStyle}"
                            Margin="4,0,0,0"
                            Click="ResetButton_Click" />
                    <Button x:Name="SupplementButton"
                            Content="补充信息"
                            Style="{StaticResource CaptureToolbarButtonStyle}"
                            Margin="4,0,0,0"
                            Click="SupplementButton_Click" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
