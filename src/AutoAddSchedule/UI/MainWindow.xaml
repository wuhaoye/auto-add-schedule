<Window x:Class="AutoAddSchedule.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoAddSchedule 自动添加日程"
        Height="820" Width="1120"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <!-- 左侧导航项：选中项显示蓝色强调条与高亮背景（通过 Tag="selected" 标记）。 -->
        <Style x:Key="MainNavButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextOnDarkMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                        Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Root" Property="Background" Value="#2C384A" />
                                <Setter TargetName="Accent" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧深色导航栏 -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,26,20,0">
                    <TextBlock Text="AutoAddSchedule" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextOnDarkBrush}" />
                    <TextBlock Text="自动添加日程" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource TextOnDarkMutedBrush}" />
                    <Border Height="1" Background="#334155" Margin="0,20,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,18,12,0">
                    <Button x:Name="NavCalendarButton" Content="日历" Margin="0,0,0,6"
                            Style="{StaticResource MainNavButtonStyle}" Click="NavCalendar_Click" />
                    <Button x:Name="NavListButton" Content="日程" Margin="0,0,0,6"
                            Style="{StaticResource MainNavButtonStyle}" Click="NavList_Click" />
                    <Button x:Name="NavSettingsButton" Content="设置" Margin="0,0,0,6"
                            Style="{StaticResource MainNavButtonStyle}" Click="NavSettings_Click" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20,0,20,18">
                    <TextBlock x:Name="HotkeyHintText" Text="快捷键 Ctrl+Alt+\ 截图添加日程"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextOnDarkMutedBrush}" />
                    <TextBlock Text="托盘常驻 · 关闭窗口不退出" FontSize="11" Margin="0,6,0,0"
                               Foreground="{StaticResource TextOnDarkMutedBrush}" />
                    <TextBlock Text="v0.1.0" FontSize="11" Margin="0,12,0,0" Opacity="0.7"
                               Foreground="{StaticResource TextOnDarkMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="ContentHost" Margin="24,16,24,16" />
        </Grid>
    </Grid>
</Window>
