<Window x:Class="AutoAddSchedule.UI.Dialogs.SupplementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="补充信息" Height="340" Width="560"
        MinHeight="280" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Style="{StaticResource AppWindowStyle}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="补充信息会随截图一起发给大模型"
                   Style="{StaticResource SectionTitleTextStyle}" />

        <TextBlock Grid.Row="1"
                   Style="{StaticResource CaptionTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,10"
                   Text="例如「提前30分钟提醒我」「地点在图书馆二号厅」。换行请直接按 Enter；按 Ctrl+Enter 或点击「确定」提交，按 Esc 取消。" />

        <TextBox Grid.Row="2"
                 x:Name="InputBox"
                 Style="{StaticResource AppTextBoxStyle}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 MinHeight="120" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
