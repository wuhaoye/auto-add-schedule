<Window x:Class="AutoAddSchedule.UI.Dialogs.ScheduleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日程"
        Height="650" Width="580"
        MinHeight="560" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontFamily}"
        Style="{StaticResource AppWindowStyle}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeadingText" Text="新增日程" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="手动添加的日程保存在本地；配置 iCloud 日历后会自动同步。"
                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 标题 -->
                <TextBlock Text="标题 *" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4" />
                <TextBox x:Name="TitleBox" Style="{StaticResource AppTextBoxStyle}" MaxLength="200"
                         PreviewKeyDown="InputBox_PreviewKeyDown" />

                <!-- 日期 + 全天 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="日期 *" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4" />
                        <DatePicker x:Name="DateBox" Height="32" SelectedDateFormat="Long"
                                    FontFamily="{StaticResource AppFontFamily}" />
                    </StackPanel>
                    <CheckBox x:Name="AllDayCheckBox" Grid.Column="1" Content="全天"
                              VerticalAlignment="Bottom" Margin="0,0,0,8" Click="AllDayCheckBox_Click" />
                </Grid>

                <!-- 开始 / 结束时间 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="开始时间 *（HH:mm）" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4" />
                        <TextBox x:Name="StartTimeBox" Style="{StaticResource AppTextBoxStyle}" MaxLength="8"
                                 PreviewKeyDown="InputBox_PreviewKeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="结束时间（可选，HH:mm）" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,4" />
                        <TextBox x:Name="EndTimeBox" Style="{StaticResource AppTextBoxStyle}" MaxLength="8"
                                 PreviewKeyDown="InputBox_PreviewKeyDown" />
                    </StackPanel>
                </Grid>

                <!-- 地点 -->
                <TextBlock Text="地点" Style="{StaticResource BaseTextStyle}" Margin="0,12,0,4" />
                <TextBox x:Name="LocationBox" Style="{StaticResource AppTextBoxStyle}" MaxLength="200"
                         PreviewKeyDown="InputBox_PreviewKeyDown" />

                <!-- 描述 -->
                <TextBlock Text="描述" Style="{StaticResource BaseTextStyle}" Margin="0,12,0,4" />
                <TextBox x:Name="DescriptionBox" Style="{StaticResource AppTextBoxStyle}" Height="78"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="2000" />

                <!-- 提前提醒 -->
                <TextBlock Text="提前提醒" Style="{StaticResource BaseTextStyle}" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="ReminderBox" Style="{StaticResource AppTextBoxStyle}" Width="90" MaxLength="5"
                             PreviewKeyDown="InputBox_PreviewKeyDown" />
                    <TextBlock Text="分钟（0 表示不提醒）" Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- 校验提示 -->
                <TextBlock x:Name="ValidationText" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True"
                    Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Content="确定" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
